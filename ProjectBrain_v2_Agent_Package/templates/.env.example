# COPY THIS TO .env in implemented repo. Adapt to actual Windows projects folder.
# Forward slashes on Windows simplify Docker Compose source path parsing.
PROJECTS_ROOT=D:/Projects
SCAN_INTERVAL_HOURS=6
FULL_HASH_AUDIT_DAYS=7
# Generate a strong random token locally; store only in ignored .env.
# Example PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
PROJECTBRAIN_AUTH_TOKEN=REPLACE_WITH_64_OR_MORE_RANDOM_HEX_CHARACTERS
