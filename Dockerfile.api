FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY Directory.Build.props NuGet.Config ./
COPY src/ ./src/
RUN dotnet restore src/ProjectBrain.Api/ProjectBrain.Api.csproj --configfile NuGet.Config
RUN dotnet publish src/ProjectBrain.Api/ProjectBrain.Api.csproj -c Release -o /out --no-restore /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /out/ ./
RUN mkdir -p /app/data /sources/projects && chown -R app:app /app/data
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "ProjectBrain.Api.dll"]

